+/// Collapse tracker ghost duplicates that sit on top of each other.
+///
+/// Mac WiFi / RSSI-only sensing has almost no spatial resolution, so the Kalman
+/// tracker often keeps several Active tracks with nearly identical centroids.
+/// That makes the UI look broken ("5 people" stacked as one stick figure) even
+/// when presence itself is correct. Keep the highest-confidence track per
+/// spatial cluster.
+fn dedupe_persons_spatially(
+    mut persons: Vec<PersonDetection>,
+    min_dist_px: f64,
+) -> Vec<PersonDetection> {
+    if persons.len() <= 1 {
+        return persons;
+    }
+    persons.sort_by(|a, b| {
+        b.confidence
+            .partial_cmp(&a.confidence)
+            .unwrap_or(std::cmp::Ordering::Equal)
+    });
+
+    let centroid = |p: &PersonDetection| -> (f64, f64) {
+        if p.keypoints.is_empty() {
+            return (p.bbox.x + p.bbox.width * 0.5, p.bbox.y + p.bbox.height * 0.5);
+        }
+        let n = p.keypoints.len() as f64;
+        (
+            p.keypoints.iter().map(|k| k.x).sum::<f64>() / n,
+            p.keypoints.iter().map(|k| k.y).sum::<f64>() / n,
+        )
+    };
+
+    let mut kept: Vec<PersonDetection> = Vec::with_capacity(persons.len());
+    for person in persons {
+        let (cx, cy) = centroid(&person);
+        let too_close = kept.iter().any(|other| {
+            let (ox, oy) = centroid(other);
+            let dx = cx - ox;
+            let dy = cy - oy;
+            (dx * dx + dy * dy).sqrt() < min_dist_px
+        });
+        if !too_close {
+            kept.push(person);
+        }
+    }
+    kept
+}
+
+/// Apply spatial ghost-dedupe and keep estimated_persons consistent with what
+/// we actually publish (important for Mac WiFi RSSI mode).
+fn finalize_wifi_persons(update: &mut SensingUpdate) {
+    if let Some(persons) = update.persons.take() {
+        let deduped = dedupe_persons_spatially(persons, 50.0);
+        let n = deduped.len();
+        update.persons = if n == 0 { None } else { Some(deduped) };
+        if n > 0 {
+            let est = update.estimated_persons.unwrap_or(0).max(n);
+            // Cap to deduped count so UI "people seen" matches skeletons.
+            update.estimated_persons = Some(est.min(n.max(1)));
+        }
+    }
+}
